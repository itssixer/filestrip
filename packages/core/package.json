{
  "name": "@filestrip/core",
  "version": "1.0.0",
  "description": "Zero-dependency EXIF/IPTC/XMP purge for JPEG, PNG, and WebP. Browser, Node, Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc --build",
    "test": "node --test test/*.test.js"
  },
  "keywords": ["exif", "iptc", "xmp", "privacy", "sanitize", "cloudflare", "workers", "strip-engine"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itssixer/filestrip.git",
    "directory": "packages/core"
  }
}
