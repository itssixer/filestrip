  "keywords": ["pii", "ocr", "redaction", "face-detection", "luhn", "mrz", "privacy"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itssixer/filestrip.git",
    "directory": "packages/sentinel"
  }
