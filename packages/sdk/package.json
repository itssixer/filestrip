{
  "name": "@filestrip/sdk",
  "version": "1.0.0",
  "description": "Purge, classify, and scan images from React, Astro, or vanilla JS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@filestrip/core": "^1.0.0",
    "@filestrip/sentinel": "^1.0.0",
    "@filestrip/vision": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "keywords": ["sdk", "react", "astro", "privacy", "exif", "moderation", "pii", "cloudflare"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itssixer/filestrip.git",
    "directory": "packages/sdk"
  }
}
